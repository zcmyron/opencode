# OpenCode 二次开发版 Dockerfile
# 用于构建和运行支持 Azure EntraID 的 OpenCode

FROM oven/bun:1.1-alpine AS builder

WORKDIR /app

# 复制项目文件
COPY . .

# 安装依赖
RUN bun install

# 构建 opencode 包
RUN cd packages/opencode && bun run build

# 创建运行时镜像
FROM oven/bun:1.1-alpine

WORKDIR /app

# 复制构建好的二进制文件和必要文件
COPY --from=builder /app/packages/opencode/bin/opencode /usr/local/bin/opencode
COPY --from=builder /app/packages/opencode/package.json /app/package.json
COPY --from=builder /app/packages/opencode/node_modules /app/node_modules

# 创建必要的目录
RUN mkdir -p /root/.opencode

# 设置环境变量
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV NODE_ENV=production

# 验证安装
RUN opencode --version

# 设置入口点
ENTRYPOINT ["opencode"]

# 默认工作目录
WORKDIR /workspace