# OpenCode 二次开发版 Dockerfile - 简化版
# 使用已构建的二进制文件

FROM oven/bun:1.1-alpine

# 安装运行时依赖
RUN apk add --no-cache libgcc libstdc++ ripgrep

WORKDIR /app

# 复制源代码和配置
COPY packages/opencode/src /app/src
COPY packages/opencode/package.json /app/package.json

# 使用 bun 直接运行（而不是编译的二进制）
# 这样可以避免跨平台问题
RUN bun install

# 创建入口脚本
RUN echo '#!/bin/sh' > /usr/local/bin/opencode && \
    echo 'cd /app && bun run src/index.ts "$@"' >> /usr/local/bin/opencode && \
    chmod +x /usr/local/bin/opencode

# 创建必要的目录
RUN mkdir -p /root/.opencode

# 设置环境变量
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV NODE_ENV=production

# 设置工作目录
WORKDIR /workspace

# 设置入口点
ENTRYPOINT ["opencode"]

# 默认命令
CMD ["--help"]